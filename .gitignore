# =======================================================
# Dependencies & Package Managers
# =======================================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =======================================================
# Next.js Build Outputs & Caches
# =======================================================
/.next/
/out/
/build/
/dist/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# =======================================================
# Testing & Coverage
# =======================================================
/coverage/
/.nyc_output/

# =======================================================
# Logs & Debugging
# =======================================================
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =======================================================
# Environment & Secret Files (Keep repo safe)
# =======================================================
.env
.env.*
.env*.local
!.env.example

# =======================================================
# Cloud & Hosting Providers
# =======================================================
.vercel
.netlify

# =======================================================
# System & Editor Files
# =======================================================
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# =======================================================
# Strict Repository Size Guards (< 10 MB limit enforcement)
# Exclude large datasets, video/audio media, weights, and binaries
# =======================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.bin
*.exe
*.dll
*.dylib
*.so

# Large media files
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3

# Model weights & large datasets
*.onnx
*.pt
*.pth
*.h5
*.pkl
*.pickle
*.parquet
*.csv
*.sqlite
*.sqlite3
*.db

# Temporary scratch scripts & files
*.tmp
*.temp
/scratch/
